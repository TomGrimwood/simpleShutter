# WiFi Configuration
CONFIG_ESP_WIFI_SSID="MY_ESP_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="MY_ESP_WIFI_PASSWORD"
CONFIG_ESP_WIFI_SCAN_METHOD_FAST=y
CONFIG_ESP_WIFI_CONNECT_TIMEOUT_MS=10000

# TCP/IP Adapter
CONFIG_ESP_NETIF_TCPIP_ADAPTER_COMPATIBILITY_LAYER=y

# Event Loop
CONFIG_ESP_EVENT_LOOP_PROFILING=n
CONFIG_ESP_EVENT_POST_FROM_ISR_IP_QUEUE_SIZE=10

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y
CONFIG_HTTPD_PURGE_BUF_LEN=32

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=100

# General ESP32 Configuration
CONFIG_ESP32_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32

# SPIFFS (Optional, but good to have for potential future use)
# CONFIG_SPIFFS_USE_SPIFFS=y 
# For now, we are embedding files, so SPIFFS is not strictly needed.
# If you enable SPIFFS, you might also need:
# CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LWIP (Networking Stack)
CONFIG_LWIP_LOCAL_HOSTNAME="esp32-webserver"
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
